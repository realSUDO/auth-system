generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model user {
  id     String    @id @default(cuid())
  name   String?
  email  String    @unique
  password String   
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt


  @@map("users")
}

model OAuthClient {
	id    String  @id @default(cuid())
	clientId	String  @unique
	clientSecret String
	redirectUri String
	name String
	createdAt DateTime @default(now())
	@@map("oauth_clients")
}

model AuthCode {
    id String @id @default(cuid())
	code String @unique
	clientId String
	userId String
	expiresAt DateTime
	used Boolean @default(false)
	createdAt DateTime @default(now())

	@@map("auth_codes")
}
